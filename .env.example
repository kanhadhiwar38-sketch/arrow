# ── AlphaPost clone configuration ──────────────────────────────────────────
# Copy to .env (optional). Every value has a safe default so the app runs with
# no .env at all.

# HTTP server
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000

# 32+ char secret used to sign session cookies and derive the AES key used for
# encrypting stored platform tokens / API keys. CHANGE THIS in production.
APP_SECRET=dev-only-change-me-please-32-chars-min

# Where the JSON datastore lives (relative to project root)
DATA_DIR=./data

# AI provider defaults (per-user keys are stored encrypted in the datastore)
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini

# OAuth callback base (used to build redirect URIs for platform connections)
OAUTH_CALLBACK_BASE=http://localhost:3000/oauth
